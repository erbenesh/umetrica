# Database
DATABASE_URL=postgresql://umetrica:umetrica@localhost:5432/umetrica

# Connections (encrypt API keys / DB passwords at rest)
CONNECTIONS_ENCRYPTION_KEY=change-me-to-a-long-random-string-at-least-32-chars

# API
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Auth (Better Auth)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3001

# Studio (invite links, password reset redirects)
STUDIO_URL=http://localhost:5173

# Email (console in dev; set RESEND_API_KEY for production)
EMAIL_FROM=umetrica <noreply@localhost>
# EMAIL_TRANSPORT=console
# RESEND_API_KEY=

# Cube.js
CUBEJS_API_SECRET=umetrica-cube-secret-change-me
CUBE_URL=http://localhost:4000
# docker-compose sets CUBEJS_CUBESTORE_HOST=cubestore for cube + refresh worker

# Insight scheduler (in-process in API; disable when using apps/worker)
# INSIGHT_SCHEDULER_ENABLED=false

# Payment (mock by default; set yookassa for production)
# PAYMENT_PROVIDER=mock
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# SALES_EMAIL=sales@umetrica.ru

# LLM (DeepSeek primary, Qwen fallback)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
