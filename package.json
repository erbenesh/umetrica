{
  "name": "umetrica",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bootstrap": "npx pnpm@9.15.4 install",
    "dev": "turbo dev --filter=@umetrica/api --filter=@umetrica/studio",
    "dev:api": "pnpm --filter @umetrica/api dev",
    "dev:studio": "pnpm --filter @umetrica/studio dev",
    "dev:worker": "pnpm --filter @umetrica/worker dev",
    "build": "turbo build",
    "build:api": "pnpm --filter @umetrica/api build",
    "build:studio": "pnpm --filter @umetrica/studio build",
    "start:api": "pnpm --filter @umetrica/api start",
    "preview:studio": "pnpm --filter @umetrica/studio preview",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "check": "turbo typecheck lint",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "db:generate": "pnpm --filter @umetrica/api db:generate",
    "db:migrate": "pnpm --filter @umetrica/api db:migrate",
    "db:push": "pnpm --filter @umetrica/api db:push"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "pnpm": "9.15.4",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1"
  }
}
